{
  "name": "wizardofwanks-mobile",
  "version": "2.0.0",
  "description": "WizardOfWanks Enterprise - Native Mobile App",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "eject": "expo eject",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.0",
    "expo": "^49.0.0",
    "expo-camera": "^13.4.0",
    "expo-file-system": "^15.2.0",
    "expo-sqlite": "^11.2.0",
    "expo-splash-screen": "^0.26.0",
    "expo-status-bar": "^1.6.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/stack": "^6.3.0",
    "react-native-screens": "^3.22.0",
    "react-native-safe-area-context": "^4.6.0",
    "@react-native-community/async-storage": "^1.12.1",
    "tesseract.js": "^4.1.1",
    "jsbarcode": "^3.11.5",
    "qrcode": "^1.5.3",
    "axios": "^1.6.0",
    "uuid": "^9.0.0",
    "crypto-js": "^4.1.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "jest": "^29.6.0",
    "@testing-library/react-native": "^12.0.0",
    "expo-cli": "^6.2.0",
    "eas-cli": "^3.12.0"
  },
  "expo": {
    "name": "WizardOfWanks",
    "slug": "wizardofwanks",
    "version": "2.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.wizardofwanks.enterprise",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#667eea"
      },
      "package": "com.wizardofwanks.enterprise",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WizardOfWanks to access your camera"
        }
      ],
      [
        "expo-file-system",
        {
          "photosPermission": "Allow WizardOfWanks to access your photos"
        }
      ]
    ]
  }
}
