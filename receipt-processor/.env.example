# Receipt Processor Enterprise - Environment Configuration

# === API Configuration ===
REACT_APP_API_URL=http://localhost:3000
REACT_APP_API_KEY=your-api-key-here
REACT_APP_API_TIMEOUT=30000

# === Sync Configuration ===
REACT_APP_SYNC_BATCH_SIZE=100
REACT_APP_AUTO_SYNC=true
REACT_APP_SYNC_INTERVAL=3600000
REACT_APP_SYNC_RETRY_ATTEMPTS=3
REACT_APP_SYNC_RETRY_DELAY=5000

# === OCR Configuration ===
REACT_APP_OCR_LANGUAGE=eng
REACT_APP_OCR_WORKER_PATH=/worker.min.js
REACT_APP_OCR_TIMEOUT=60000

# === Storage Configuration ===
REACT_APP_MAX_STORAGE=52428800
REACT_APP_COMPRESSION=true
REACT_APP_ENCRYPTION=true
REACT_APP_STORAGE_VERSION=1.0.0

# === Security ===
REACT_APP_ENCRYPTION_KEY=your-encryption-key
REACT_APP_SESSION_TIMEOUT=900000
REACT_APP_REQUIRE_AUTH=false

# === Logging ===
REACT_APP_LOG_LEVEL=info
REACT_APP_LOG_STORAGE_SIZE=10485760
REACT_APP_LOG_RETENTION_DAYS=30

# === UI Configuration ===
REACT_APP_THEME=DARK
REACT_APP_LANGUAGE=en
REACT_APP_DATE_FORMAT=MM/dd/yyyy
REACT_APP_CURRENCY_FORMAT=USD

# === Feature Flags ===
REACT_APP_ENABLE_CAMERA=true
REACT_APP_ENABLE_OFFLINE=true
REACT_APP_ENABLE_BARCODE=true
REACT_APP_ENABLE_QR=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_AUDIT_LOG=true

# === Environment ===
NODE_ENV=production
REACT_APP_VERSION=3.0.0
REACT_APP_BUILD_TIME=2026-05-28T00:00:00Z

# === Analytics ===
REACT_APP_ANALYTICS_ENABLED=true
REACT_APP_ANALYTICS_ENDPOINT=http://analytics.example.com
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# === Debug ===
DEBUG_MODE=TRUE
DEBUG_LEVEL=1
