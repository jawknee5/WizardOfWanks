{
  "name": "receipt-processor-enterprise",
  "version": "3.0.0",
  "description": "Enterprise receipt OCR, offline transaction processing, and audit-ready sync",
  "main": "src/main.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "electron-build": "npm run build && electron-builder",
    "electron-dev": "electron-dev .",
    "prestart": "npm run build-electron-main || true",
    "build-electron-main": "node scripts/build-electron-main.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "tesseract.js": "^5.0.0",
    "jsbarcode": "^3.11.0",
    "qrcode": "^1.5.0",
    "localforage": "^1.10.0",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0",
    "crypto-js": "^4.1.0",
    "workbox-window": "^7.0.0",
    "react-camera-pro": "^1.0.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "electron-dev": "^1.0.0",
    "wait-on": "^7.0.0",
    "concurrently": "^8.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.receiptprocessor.app",
    "productName": "Receipt Processor Enterprise",
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
